# ==============================================================================
# NOVA Environment Configuration Template
# ==============================================================================
# NOTE: Do NOT commit your real keys or .env file to version control.
# The backend loads these environment variables securely at startup.
# ==============================================================================

# ------------------------------------------------------------------------------
# Gemini API Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------------------------
# Backend-only authentication secrets (generate independent random values)
# ------------------------------------------------------------------------------
NOVA_SESSION_SECRET=replace_with_at_least_32_random_bytes
OTP_HASH_SECRET=replace_with_a_different_32_random_bytes

# -------------------------------------------------------------------------------
# Firebase Admin service account (keep the JSON file outside the repository)
# -------------------------------------------------------------------------------
# Set one option. The path must point to a Firebase service-account JSON file.
# FIREBASE_SERVICE_ACCOUNT_PATH=<absolute path to service account JSON>
# Alternatively, set FIREBASE_SERVICE_ACCOUNT_JSON or FIREBASE_SERVICE_ACCOUNT_BASE64.

# ------------------------------------------------------------------------------
# Brevo Email Service Configuration
# ------------------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=notifications@yourdomain.com
BREVO_SENDER_NAME="NOVA Virtual Wardrobe"

# ------------------------------------------------------------------------------
# Decart Virtual Try-On (VTON) Credential Pool (BACKEND ONLY)
# ------------------------------------------------------------------------------
# You can define up to 50 permanent Decart API keys using DECART_API_KEY_1..50
# (Legacy VTON_API_KEY_1..50 or DECART_API_KEY are also supported).
#
# Replace the placeholder values below with your authorized Decart API keys:
DECART_API_KEY_1=your_first_decart_permanent_key
DECART_API_KEY_2=your_second_decart_permanent_key
DECART_API_KEY_3=your_third_decart_permanent_key
# DECART_API_KEY_4=...
# DECART_API_KEY_20=...

# (Optional) Active pool size to inspect (default is auto-detected count of configured keys)
DECART_KEY_POOL_SIZE=3

# (Optional) Rotation policy: 'global_round_robin' (default)
DECART_ROTATION_POLICY=global_round_robin

# (Optional) Cooldown period in seconds when a key hits 429 rate limit or capacity (default: 60)
DECART_COOLDOWN_SECONDS=60

# (Optional) Max retry/fallback attempts on transient errors (default: 3)
DECART_MAX_FALLBACK_ATTEMPTS=3

# Secret key to protect administrative pool inspection endpoints
DECART_ADMIN_SECRET=your_secure_admin_secret_here

# ------------------------------------------------------------------------------
# Optional: Quota Groups
# If multiple keys share the same billing account/credit balance, assign them the
# same quota group so if one exhausts credits (402), the whole group cools down:
# DECART_QUOTA_GROUP_1=team_alpha
# DECART_QUOTA_GROUP_2=team_alpha
# DECART_QUOTA_GROUP_3=team_beta
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Client / Mobile App API Base URL
# ------------------------------------------------------------------------------
# Web dev: leave blank (defaults to relative /api)
# Android physical device via local Wi-Fi: http://<YOUR_COMPUTER_LAN_IP>:3000
# Production Render backend: https://nova-1-1.onrender.com
# VITE_API_BASE_URL=
