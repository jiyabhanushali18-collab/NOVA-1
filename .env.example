# ==============================================================================
# NOVA Environment Configuration Template
# ==============================================================================
# NOTE: Do NOT commit your real keys or .env file to version control.
# The backend loads these environment variables securely at startup.
# ==============================================================================

# ------------------------------------------------------------------------------
# Gemini API Configuration (server-only; required for AI try-on style scoring)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------------------------
# Backend-only authentication secrets (generate independent random values)
# ------------------------------------------------------------------------------
NOVA_SESSION_SECRET=replace_with_at_least_32_random_bytes
OTP_HASH_SECRET=replace_with_a_different_32_random_bytes

# -------------------------------------------------------------------------------
# Firebase Admin service account (keep the JSON file outside the repository)
# -------------------------------------------------------------------------------
# Set one option. The path must point to a Firebase service-account JSON file.
# FIREBASE_SERVICE_ACCOUNT_PATH=<absolute path to service account JSON>
# Alternatively, set FIREBASE_SERVICE_ACCOUNT_JSON or FIREBASE_SERVICE_ACCOUNT_BASE64.

# ------------------------------------------------------------------------------
# Brevo Email Service Configuration
# ------------------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=notifications@yourdomain.com
BREVO_SENDER_NAME="NOVA Virtual Wardrobe"

# ------------------------------------------------------------------------------
# Decart Virtual Try-On (VTON) 32-Key Credential Pool (BACKEND ONLY)
# ------------------------------------------------------------------------------
# The Decart Key Manager loads all 32 keys securely from backend environment
# variables. Keys are NEVER exposed in frontend code, APK bundles, logs, or APIs.
#
# Configure your authorized Decart API keys below (DECART_API_KEY_01 .. 32):
DECART_API_KEY_01=
DECART_API_KEY_02=
DECART_API_KEY_03=
DECART_API_KEY_04=
DECART_API_KEY_05=
DECART_API_KEY_06=
DECART_API_KEY_07=
DECART_API_KEY_08=
DECART_API_KEY_09=
DECART_API_KEY_10=
DECART_API_KEY_11=
DECART_API_KEY_12=
DECART_API_KEY_13=
DECART_API_KEY_14=
DECART_API_KEY_15=
DECART_API_KEY_16=
DECART_API_KEY_17=
DECART_API_KEY_18=
DECART_API_KEY_19=
DECART_API_KEY_20=
DECART_API_KEY_21=
DECART_API_KEY_22=
DECART_API_KEY_23=
DECART_API_KEY_24=
DECART_API_KEY_25=
DECART_API_KEY_26=
DECART_API_KEY_27=
DECART_API_KEY_28=
DECART_API_KEY_29=
DECART_API_KEY_30=
DECART_API_KEY_31=
DECART_API_KEY_32=

# (Optional backward-compatibility: unpadded DECART_API_KEY_1 .. 32 are also supported)

# Target pool size to manage (default: 32)
DECART_KEY_POOL_SIZE=32

# Rotation policy: 'global_round_robin' (default)
DECART_ROTATION_POLICY=global_round_robin

# Cooldown period in seconds when a key hits 429 rate limit (default: 60)
DECART_COOLDOWN_SECONDS=60

# Max fallback attempts across healthy keys on transient errors (default: 5)
DECART_MAX_FALLBACK_ATTEMPTS=5

# Secret key to protect administrative pool inspection endpoints
DECART_ADMIN_SECRET=your_secure_admin_secret_here

# ------------------------------------------------------------------------------
# Optional: Quota Groups
# If multiple keys share the same billing account/credit balance, assign them the
# same quota group so if one exhausts credits (402), the whole group cools down:
# DECART_QUOTA_GROUP_01=team_alpha
# DECART_QUOTA_GROUP_02=team_alpha
# DECART_QUOTA_GROUP_03=team_beta
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Client / Mobile App API Base URL
# ------------------------------------------------------------------------------
# Web dev: leave blank (defaults to relative /api)
# Android physical device via local Wi-Fi: http://<YOUR_COMPUTER_LAN_IP>:3000
# Production Render backend: https://nova-1-1.onrender.com
PUBLIC_API_URL=https://nova-1-1.onrender.com
VITE_API_BASE_URL=https://nova-1-1.onrender.com

# ------------------------------------------------------------------------------
# AI Vision & Garment Background Removal (FastAPI) Backend URL
# ------------------------------------------------------------------------------
# Backend-to-backend URL used by Render Node server to proxy garment upload requests:
AI_BACKEND_URL=http://127.0.0.1:8000
# Optional: Public FastAPI URL if deployed on dedicated web service (Render, Railway, Fly):
# VITE_AI_API_BASE_URL=https://your-nova-ai-fastapi.onrender.com
# PUBLIC_AI_URL=https://your-nova-ai-fastapi.onrender.com
