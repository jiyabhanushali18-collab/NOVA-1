rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.productId is string
        && request.resource.data.rating is number;
      allow update, delete: if request.auth != null
        && resource.data.accountUid == request.auth.uid;
    }

    match /fashionRules/{ruleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && (
          request.auth.uid == userId
          || (request.auth.token.email != null && request.auth.token.email == userId)
        );

      match /{subcollection=**}/{documentId} {
        allow read, write: if request.auth != null
          && (
            request.auth.uid == userId
            || (request.auth.token.email != null && request.auth.token.email == userId)
          );
      }
    }

    match /legal_consents/{consentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.accepted == true
        && request.resource.data.termsVersion is string
        && request.resource.data.privacyVersion is string
        && request.resource.data.consentedAt is string;
      allow update, delete: if false;
    }
  }
}
