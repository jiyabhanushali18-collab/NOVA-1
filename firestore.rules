rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsVendor(vendorId) {
      return signedIn() && (
        (
          exists(/databases/$(database)/documents/owner/$(request.auth.uid))
          && get(/databases/$(database)/documents/owner/$(request.auth.uid)).data.vendorId == vendorId
        )
        || (
          exists(/databases/$(database)/documents/vendors/$(vendorId))
          && get(/databases/$(database)/documents/vendors/$(vendorId)).data.uid == request.auth.uid
        )
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.productId is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.accountUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0;
      allow update, delete: if request.auth != null
        && resource.data.accountUid == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if ownsVendor(resource.data.vendorId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'productId', 'productName', 'vendorId', 'arTryOn', 'arRating', 'rating',
          'comment', 'feedback', 'author', 'customerName', 'userName', 'userId',
          'uid', 'color', 'variantColor', 'createdAt'
        ])
        && request.resource.data.productId is string
        && request.resource.data.vendorId is string
        && request.resource.data.arTryOn == true
        && request.resource.data.arRating is number
        && request.resource.data.arRating >= 1
        && request.resource.data.arRating <= 5
        && (!('comment' in request.resource.data) || request.resource.data.comment is string && request.resource.data.comment.size() <= 1000)
        && (!('feedback' in request.resource.data) || request.resource.data.feedback is string && request.resource.data.feedback.size() <= 1000)
        && (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.vendorId == request.resource.data.vendorId;
      allow update, delete: if false;
    }

    match /fashionRules/{ruleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && (
          request.auth.uid == userId
          || (request.auth.token.email != null && request.auth.token.email == userId)
        );

      match /{subcollection=**}/{documentId} {
        allow read, write: if request.auth != null
          && (
            request.auth.uid == userId
            || (request.auth.token.email != null && request.auth.token.email == userId)
          );
      }
    }

    match /legal_consents/{consentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.accepted == true
        && request.resource.data.termsVersion is string
        && request.resource.data.privacyVersion is string
        && request.resource.data.consentedAt is string;
      allow update, delete: if false;
    }
  }
}
